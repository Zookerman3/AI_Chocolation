# Optional override: a Roboflow-hosted object detection model for the camera.
# Leave both blank (the default) and the camera uses the on-device recogniser in
# src/features/camera/ — no key, no server. Set both and it calls Roboflow instead;
# see src/features/camera/roboflowDetector.ts for the class-naming convention
# (a Roboflow class must be named exactly as the flavor's id in src/data/flavors.json).
VITE_ROBOFLOW_API_KEY=
VITE_ROBOFLOW_MODEL_ID=
