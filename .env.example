# Roboflow-hosted object detection model for camera-assisted box capture (Phase 2).
# See src/features/camera/roboflowDetector.ts for the class-naming convention
# (a Roboflow class must be named exactly as the flavor's id in src/data/flavors.json).
# Leave both blank to fall back to the stub detector: the camera flow still works,
# it just won't detect anything real.
VITE_ROBOFLOW_API_KEY=
VITE_ROBOFLOW_MODEL_ID=
